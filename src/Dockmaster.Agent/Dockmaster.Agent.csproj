<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Dockmaster.Agent</RootNamespace>
    <!-- a small heap on a host that has better things to do: no background GC thread -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.9" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Dockmaster.Shared\Dockmaster.Shared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Dockmaster.IntegrationTests" />
    <InternalsVisibleTo Include="Dockmaster.Tests" />
  </ItemGroup>
</Project>
